# Supabase API (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database direct connection (Settings > Database > Connection string > URI)
# Example: postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=

# Optional: migration alternatives
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Cloudflare R2 — 교수 사진 등 이미지 업로드 (강의 영상과 같은 버킷)
# R2는 브라우저에서 직접 올릴 수 없어 서버 액션에서만 사용합니다.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lms-video
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# PayApp 결제 연동 (자격증 발급비)
# 값은 PayApp 관리자 > 환경설정 > 연동정보 에서 확인합니다.
PAYAPP_USER_ID=your-payapp-id
PAYAPP_LINK_KEY=your-link-key
PAYAPP_LINK_VALUE=your-link-value
PAYAPP_SHOP_NAME=한평생 직업훈련
# 결제 결과 통보(webhook)를 받을 공개 주소. localhost로는 통보가 오지 않습니다.
NEXT_PUBLIC_SITE_URL=https://korhrd-lms.vercel.app/

PAYAPP_USERID=korhrd
PAYAPP_SHOP_NAME=한평생그룹
PAYAPP_LINK_KEY=aQw+jpz2R7e5WAgEni1N4e1DPJnCCRVaOgT+oqg6zaM=
NEXT_PUBLIC_BASE_URL=http://localhost:3000# 테스트 결제 — PayApp에는 테스트 서버가 없어 실결제로만 확인할 수 있습니다.
# 아래 두 값을 함께 넣으면 그 아이디의 회원만 소액으로 결제됩니다(최소 1,000원).
# 운영에 남아 있어도 지정한 아이디 외에는 영향이 없습니다.
PAYAPP_TEST_LOGIN_ID=payapp_test
PAYAPP_TEST_AMOUNT=1000
