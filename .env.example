# 네이버 클라우드 SENS — 아이디·비밀번호 찾기 휴대폰 문자 인증
#  · SENS_SERVICE_ID  : Console > Services > SENS > SMS > 프로젝트 (ncp:sms:kr:...)
#  · ACCESS/SECRET KEY: 마이페이지 > 계정관리 > 인증키 관리
#  · SENS_SENDER_PHONE: SENS에 사전 등록·승인된 발신번호 (미등록 번호는 발송 실패)
# 설정이 들어갔는지는 /api/sens/status 로 확인할 수 있습니다.
SENS_SERVICE_ID=ncp:sms:kr:000000000000:hanpyeong
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SENDER_PHONE=0221359249

# 네이버 로그인 (https://developers.naver.com/apps)
#  · Callback URL 등록: {사이트주소}/api/auth/naver/callback
#  · 제공 정보에 이름·휴대전화번호를 넣어야 기존 회원과 이어붙일 수 있습니다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 카카오 로그인 (https://developers.kakao.com/console/app)
#  · Redirect URI 등록: {사이트주소}/api/auth/kakao/callback
#  · 연결 끊기 콜백: {사이트주소}/api/auth/kakao/unlink
#  · 동의항목에 이름·전화번호를 켜야 기존 회원과 이어붙습니다(비즈니스 앱 검수 필요)
#  · 앱 키는 REST API 키입니다. Client Secret 은 켠 경우에만 채우세요.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 알리고 카카오 알림톡 — 회원가입·수강률 독려 발송
#  · Vercel은 IP가 바뀌어 알리고 화이트리스트에 걸리므로 고정 IP 프록시를 경유
#  · 프록시: 한평생오피스 신한 프록시 서버(KorhrdGroupDB/shinhan-proxy) 공용
#  · 계정 정보: smartsms.aligo.in 관리자 페이지 또는 오피스 Vercel 환경변수
#  · 템플릿 코드: 카카오 검수 승인 후 src/lib/aligo/alimtalk.ts에 기입
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=
ALIGO_SENDER=
ALIGO_PROXY_URL=http://114.207.245.105:8080
ALIGO_PROXY_SECRET=
